{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "//": "bin/e2e-prove.mjs (the shipped launcher: watchdog + retry) is intentionally plain JS, not typechecked — allowJs is off here, so no *.mjs glob.",
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.unit.config.ts", "server/**/*.ts", "src/proof/execute.ts", "src/proof/spawn.ts", "src/agent/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
}
